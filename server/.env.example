# ============================================================================
# OpenCNS v2 server —— 环境变量样板
# 复制为 .env 后填写真实值。.env 已在 .gitignore 中，绝不提交。
# 所有变量在启动时由 src/config.ts 校验；缺失或非法会直接拒绝启动（fail closed）。
# ============================================================================

NODE_ENV=production
PORT=3000

# debug | info | warn | error
LOG_LEVEL=info

# --- 数据库（腾讯云自建 Postgres 16 + pgvector）-----------------------------
DATABASE_URL=postgresql://opencns:换成强密码@127.0.0.1:5432/opencns
DB_POOL_MAX=5

# --- Embedding ---------------------------------------------------------------
# cloud = 云 API（推荐，几乎不占服务器内存）
# ollama = 服务器本地 Ollama（隐私最好，但 bge-m3 载入时要 1.5~2GB 内存）
EMBEDDING_PROVIDER=cloud
EMBEDDING_DIM=1024
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=

# 仅当 EMBEDDING_PROVIDER=ollama 时使用
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 闲置 5 分钟自动卸载模型，给 4GB 机器留内存
OLLAMA_KEEP_ALIVE=5m

# --- LLM ---------------------------------------------------------------------
# 主对话模型：她看到的话
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_API_KEY=
CHAT_MODEL=deepseek-chat

# 认知模型：召回裁决 / 认知抽取 / 情景压缩 / 反思
COGNITIVE_BASE_URL=https://api.deepseek.com/v1
COGNITIVE_API_KEY=
COGNITIVE_MODEL=deepseek-chat

# --- 推送（Android · 微信）---------------------------------------------------
# PushPlus 的「用户token」（一对一推送页面那个），**不是**群组/消息 token
PUSHPLUS_TOKEN=
PUSHPLUS_BASE_URL=https://www.pushplus.plus

# --- 边界安全 ----------------------------------------------------------------
# 设置后 /chat 与 /admin/* 需要 authorization: Bearer <API_TOKEN>
# 建议生成：openssl rand -hex 24
API_TOKEN=
# 允许的前端来源，逗号分隔；留空则不开 CORS
CORS_ORIGINS=

# --- 其他 --------------------------------------------------------------------
TIMEZONE=Asia/Shanghai
# 启动阶段是否允许写库（v2 默认 false：启动零写副作用）
ALLOW_BOOT_WRITES=false
